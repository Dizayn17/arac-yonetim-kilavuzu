{
  "name": "arac-filo-yonetimi",
  "productName": "Araç Filo Yönetimi",
  "version": "1.3.1",
  "description": "Araç filo yönetimi: araç kartları, zimmet, belge, yakıt, bakım, gider, uyarı ve raporlar. Windows masaüstü + web sürümü.",
  "main": "main.js",
  "author": "Onur Türkyılmaz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/apply-brand.js dardanel && electron .",
    "web": "node scripts/build-web.js && npx --yes serve dist-web -l 8080",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tr.filo.aracyonetimi",
    "productName": "Araç Filo Yönetimi",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Araç Filo Yönetimi",
      "artifactName": "AracFilo-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AracFilo-Tasinabilir-${version}.${ext}"
    }
  },
  "brandId": "dardanel"
}
